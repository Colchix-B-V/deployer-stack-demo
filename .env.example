# Defaults run everything locally through gateway.py and Ollama: no key needed.
# To use OpenAI directly instead, uncomment and fill in:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small

# Who reviews drafts in interactive mode (written to the audit log)
# REVIEWER=agent.weber
